# À créer dans Netlify (Site configuration > Environment variables). Ne jamais committer de vraies valeurs.
# En local : copier ce fichier en .env (ignoré par git) et remplir.

# Mot de passe partagé de l'équipe pour l'espace protégé
TEAM_PASSWORD=
# Secret de signature des cookies de session (min. 32 caractères aléatoires) : openssl rand -base64 48
SESSION_SECRET=
# Jeton Bearer de l'API GET /api/cdc pour Claude / MCP : openssl rand -base64 32
API_TOKEN=
